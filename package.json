{
	"name": "typa",
	"version": "1.1.11",
	"description": "",
	"type": "module",
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"build": "vite build",
		"build:pdf-wasm": "bun scripts/buildPdfWasm.ts",
		"build:web": "bun run build:pdf-wasm && vite build",
		"serve": "vite preview",
		"tauri": "tauri",
		"fix": "biome check --write .",
		"check": "biome check . --error-on-warnings",
		"test": "vitest run",
		"test:security": "vitest run src/test/security",
		"test:watch": "vitest",
		"bench": "vitest bench --run -c vitest.bench.config.ts",
		"bench:browser": "vitest bench --run -c vitest.browser-bench.config.ts",
		"bench:db": "bun scripts/prepareReleaseDb.ts typa_bench --replace && bun scripts/benchDb.ts typa_bench",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
		"test:e2e": "playwright test",
		"docs:user-manual": "playwright test -c playwright.manual.config.ts",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --workspace",
		"seed": "bun scripts/generateSeed.ts && docker exec -i supabase_db_typa psql -U postgres -d postgres -v ON_ERROR_STOP=1 -q -o /dev/null < supabase/seed.sql"
	},
	"license": "MIT",
	"packageManager": "bun@1.4.4",
	"dependencies": {
		"@solidjs/router": "^1.0.3",
		"@supabase/supabase-js": "^2.119.0",
		"@tauri-apps/api": "~2.12.4",
		"@tauri-apps/plugin-dialog": "~2.8.4",
		"@tauri-apps/plugin-opener": "~2.7.3",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "~2.14.1",
		"lucide-solid": "^1.72.0",
		"solid-js": "^1.9.19"
	},
	"overrides": {
		"@babel/core": "7.29.6",
		"browserslist": "4.29.3",
		"baseline-browser-mapping": "2.11.27",
		"seroval": "1.6.11",
		"seroval-plugins": "1.6.8",
		"source-map-js": "1.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@electric-sql/pglite": "^0.5.16",
		"@faker-js/faker": "10.6.0",
		"@fast-check/vitest": "0.5.0",
		"@playwright/test": "^1.65.0",
		"@solidjs/testing-library": "^0.8.10",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "5.1.0",
		"fast-check": "4.10.2",
		"happy-dom": "^21.0.4",
		"typescript": "~7.0.2",
		"vite": "^8.3.8",
		"vite-plugin-solid": "^2.11.16",
		"vitest": "^5.1.0"
	}
}
