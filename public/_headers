# Cloudflare Pages が返すヘッダー(Web 版)。デスクトップ版の CSP は src-tauri/tauri.conf.json
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://nfznynngzjigixdmvhur.supabase.co wss://nfznynngzjigixdmvhur.supabase.co; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# PDF の WASM は名前がリリースをまたいで変わらないので、毎回新しいかを確かめる(変わっていなければ 304)
/typa-pdf.wasm.gz
  Cache-Control: no-cache
