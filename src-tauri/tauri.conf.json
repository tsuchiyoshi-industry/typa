{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "typa",
	"version": "0.4.3",
	"identifier": "com.typa.app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "typa",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFNTRCMjNBN0M4QzIyOEIKUldTTElveDhPckpVemhxUGVsMXJSY3pocHNBbFc1dDNZQ3NsR2pEN2pYeXZZQ0JjWHpDVXFNbk8K",
			"endpoints": [
				"https://github.com/tsuchiyoshi-industry/typa/releases/latest/download/latest.json"
			]
		}
	}
}
