{
	"compilerOptions": {
		"target": "ES2022",
		"strict": true,
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true
	},
	"include": [
		"vite.config.ts",
		"vitest.config.ts",
		"vitest.bench.config.ts",
		"vitest.browser-bench.config.ts",
		"playwright.config.ts",
		"scripts/**/*.ts",
		"e2e/**/*.ts",
		"src/vite-env.d.ts"
	]
}
